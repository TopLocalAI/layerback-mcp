{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.toplocalai/layerback-mcp",
  "description": "Convert diagram images into fully editable Visio (VSDX), PowerPoint, draw.io, and SVG files.",
  "repository": {
    "url": "https://github.com/TopLocalAI/layerback-mcp",
    "source": "github"
  },
  "version": "0.1.1",
  "websiteUrl": "https://layerback.com/docs/api",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "layerback-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LAYERBACK_API_KEY",
          "description": "LayerBack API key from https://layerback.com/settings/apikeys",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
